#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_temp_layer {
    excluded-positions = <
        18 // J
        19 // K
        34 // Ctrl
        35 // Win
        36 // Alt
    >;
};

&zip_temp_layer { require-prior-idle-ms = <200>; };

&mkp_input_listener { input-processors = <&zip_temp_layer 8 250>; };

&trackball {
    scroll-layers = <9>;

    arrows {
        layers = <9>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <10>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

&trackball_listener {
    compatible = "zmk,input-listener";
    device = <&trackball>;
    input-processors = <&zip_xy_scaler 7 4>, <&zip_temp_layer 8 60000>;

    drag_precision {
        layers = <7>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        mouse_prev {
            bindings = <&mkp MB4>;
            key-positions = <18 19>;
        };

        mouse_next {
            bindings = <&mkp MB5>;
            key-positions = <20 19>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off 8>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        encoder_msc_left_right: encoder_msc_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_LEFT_RIGHT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        encoder_zoom_out_in: encoder_zoom_out_in {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_ZOOM_OUT_IN";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(MINUS)>, <&kp LC(PLUS)>;

            tap-ms = <20>;
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_default_layer {
            bindings = <
&lt 7 Q           &kp W           &kp E         &kp R      &kp T                                          &kp Y        &kp U  &kp I      &kp O    &lt 9 P
&kp A             &kp S           &kp D         &kp F      &kp G        &kp LS(LG(S))      &kp F7         &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z             &kp X           &kp C         &kp V      &kp B        &kp TAB            &lt 7 F10      &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT  &lt 4 F14  &lt 3 SPACE  &lt 6 F15          &kp BACKSPACE  &lt 2 ENTER                             &kp LEFT_WIN
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        mac_default_layer {
            bindings = <
&lt 7 Q       &kp W           &kp E         &kp R      &kp T                                          &kp Y        &kp U  &kp I      &kp O    &lt 9 P
&kp A         &kp S           &kp D         &kp F      &kp G        &kp LS(LG(S))      &kp F7         &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z         &kp X           &kp C         &kp V      &kp B        &kp TAB            &lt 7 F10      &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_WIN  &kp LEFT_SHIFT  &kp LEFT_ALT  &lt 5 F14  &lt 3 SPACE  &lt 6 F15          &kp BACKSPACE  &lt 2 ENTER                             &kp LEFT_CONTROL
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        symbol_layer {
            bindings = <
&trans     &kp AMPERSAND    &kp ASTERISK  &kp QUESTION  &kp MINUS                           &trans             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans
&kp GRAVE  &kp DOLLAR       &kp PERCENT   &kp CARET     &kp COLON      &trans       &trans  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &trans
&kp MINUS  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp SEMICOLON  &trans       &trans  &kp SQT            &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE       &trans
&trans     &trans           &trans        &trans        &kp F16        &kp F14      &trans  &trans                                                                         &trans
            >;

            sensor-bindings = <&encoder_zoom_out_in>;
        };

        num_layer {
            bindings = <
&kp ESCAPE  &trans           &kp UP_ARROW  &kp QUESTION  &trans                          &kp ASTERISK     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS
&kp HOME    &kp LEFT         &kp DOWN      &kp RIGHT     &kp END  &trans      &kp EQUAL  &kp MINUS        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS
&kp DELETE  &kp EXCLAMATION  &kp AT_SIGN   &kp LG(V)     &trans   &trans      &kp COLON  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp SLASH
&trans      &trans           &trans        &trans        &trans   &trans      &trans     &kp PERIOD                                                          &trans
            >;
        };

        ctrl_layer {
            bindings = <
&kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)                      &kp LC(Y)  &kp LC(U)  &kp LC(I)  &kp LC(O)  &kp LC(P)
&kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(G)  &trans      &trans  &kp LC(H)  &kp LC(J)  &kp LC(K)  &kp LC(L)  &trans
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(B)  &trans      &trans  &kp LC(N)  &kp LC(M)  &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans      &trans  &trans                                      &trans
            >;
        };

        cmd_layer {
            bindings = <
&kp LG(Q)  &kp LG(W)  &kp LG(E)  &kp LG(R)  &kp LG(T)                      &kp LG(Y)  &kp LG(U)  &kp LG(I)  &kp LG(O)  &kp LG(P)
&kp LG(A)  &kp LG(S)  &kp LG(D)  &kp LG(F)  &kp LG(G)  &trans      &trans  &kp LG(H)  &kp LG(J)  &kp LG(K)  &kp LG(L)  &trans
&kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)  &trans      &trans  &kp LG(N)  &kp LG(M)  &trans     &trans     &trans
&trans     &trans     &trans     &trans     &trans     &trans      &trans  &trans                                      &trans
            >;
        };

        shift_layer {
            bindings = <
&kp LS(Q)  &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)                      &kp LS(Y)  &kp LS(U)  &kp LS(I)      &kp LS(O)         &kp LS(P)
&kp LS(A)  &kp LS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)  &trans      &trans  &kp LS(H)  &kp LS(J)  &kp LS(K)      &kp LS(L)         &kp UNDERSCORE
&kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)  &trans      &trans  &kp LS(N)  &kp LS(M)  &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION
&trans     &trans     &trans     &trans     &trans     &trans      &trans  &trans                                                 &trans
            >;

            sensor-bindings = <&encoder_msc_left_right>;
        };

        function_drag_layer {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F12                      &bt BT_SEL 0  &bt BT_SEL 1  &tog 1    &trans  &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans      &trans  &trans        &mkp MB1      &mkp MB2  &trans  &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans      &trans  &trans        &trans        &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans   &trans      &trans  &trans                                        &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
